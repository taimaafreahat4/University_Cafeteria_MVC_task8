@model University_Cafeteria_Task8.Models.LoginDTO

<h2>Login</h2>

<form action="@Url.Action("Login", "Account")"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input asp-for="Password"
               type="password"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Login
    </button>

    <a href="@Url.Action("Register", "Account")"
       class="btn btn-secondary">
        Register
    </a>

</form>
